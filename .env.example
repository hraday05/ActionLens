# ──────────────────────────────────────────────────────────────
# ActionLens — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file itself to git.
# ──────────────────────────────────────────────────────────────

# Required: Groq API key (free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Required for live OTP emails: Resend API key (free at https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Override SQLite DB path (used for Render persistent disk)
# DB_PATH=/app/data/actionlens.db
