# ──────────────────────────────────────────────────────────────
# ActionLens — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file itself to git.
# ──────────────────────────────────────────────────────────────

# Required: Groq API key (free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Gmail SMTP for OTP emails
# If not set, OTP is printed to server terminal (local dev mode)
SMTP_EMAIL=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password

# Optional: Override SQLite DB path (used for Render persistent disk)
# DB_PATH=/app/data/actionlens.db
